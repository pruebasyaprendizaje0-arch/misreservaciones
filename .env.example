# =================================================================
# 🗄️ BASE DE DATOS POSTGRESQL (Vultr / Coolify)
# =================================================================
# 1. Base de datos del Plano de Control (usuarios, tenants, suscripciones):
#    - En red interna de Coolify: postgresql://postgres:TU_PASSWORD@postgres:5432/misreservaciones_control?schema=public
#    - O por IP / Host de Vultr:  postgresql://postgres:TU_PASSWORD@TU_IP_O_DOMINIO:5432/misreservaciones_control?schema=public
DATABASE_URL_CONTROL="postgresql://postgres:postgres_password@localhost:5432/misreservaciones_control?schema=public"

# 2. Conexión de Administrador Postgres para aprovisionar bases de datos y roles de cada negocio:
#    Debe ser un usuario con permisos CREATEDB y CREATEROLE (por defecto el usuario 'postgres' de Coolify).
POSTGRES_ADMIN_URL="postgresql://postgres:postgres_password@localhost:5432/postgres?schema=public"

# 3. Modo de Base de Datos Propia (Deshabilitar API externa para operar 100% autónomo):
USE_CENTRAL_API="false"
API_INTERNAL_URL=""
NEXT_PUBLIC_API_URL=""


# --- Auth.js ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Domain / multi-tenant ---
# Root domain for tenant subdomains. In dev, leave as localhost.
ROOT_DOMAIN="tusreservas.com"
# Set to 1 to enable ?tenant=<slug> override for local dev (DO NOT use in prod).
ENABLE_TENANT_QUERY_PARAM="1"

# --- App ---
APP_TIMEZONE="America/Santo_Domingo"
DEFAULT_LOCALE="es"

# --- Optional: Stripe (dejar vacío en MVP) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Optional: SMTP for transactional email ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@tusreservas.com"

# --- Optional: Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

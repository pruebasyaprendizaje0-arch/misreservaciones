# --- Control Plane ---
DATABASE_URL_CONTROL="postgresql://misreservaciones:CHANGE_ME@localhost:5432/misreservaciones_control?schema=public"

# --- Admin role to create tenant DBs ---
# Must be a Postgres role with CREATEDB privilege.
POSTGRES_ADMIN_URL="postgresql://postgres:CHANGE_ME@localhost:5432/postgres?schema=public"

# --- Auth.js ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Domain / multi-tenant ---
# Root domain for tenant subdomains. In dev, leave as localhost.
ROOT_DOMAIN="tusreservas.com"
# Set to 1 to enable ?tenant=<slug> override for local dev (DO NOT use in prod).
ENABLE_TENANT_QUERY_PARAM="1"

# --- App ---
APP_TIMEZONE="America/Santo_Domingo"
DEFAULT_LOCALE="es"

# --- Optional: Stripe (dejar vacío en MVP) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Optional: SMTP for transactional email ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@tusreservas.com"

# --- Optional: Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
